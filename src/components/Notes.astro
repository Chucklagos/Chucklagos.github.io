---
import { getCollection } from 'astro:content';
const posts = await getCollection('blog',({data})=>!data.draft);
---
<section class="section section-muted" id="notes"><div class="container"><div class="section-heading"><p class="section-index">06 / Blog & technical notes</p><h2>References from day-to-day work.</h2><p>My personal notebook for commands, configurations, and things I’m learning. <a href="/blog/">Browse and search all notes →</a></p></div><div class="notes-grid">{posts.slice(0,3).map(post=><a class="note-card" href={`/blog/${post.id}/`}><span>{post.data.tags.join(' / ')}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><strong>Read note →</strong></a>)}</div></div></section>
