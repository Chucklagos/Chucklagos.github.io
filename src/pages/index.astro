<div aria-label="Primary actions" class="hero-actions">
<a class="button button-primary" href="#work">View My Work</a>
<a class="button" href="/Chuck_Guifarro_Resume.pdf" download>Download Resume</a>

<a class="text-link" href="https://www.linkedin.com/in/chucklagos/" rel="noopener" target="_blank">LinkedIn
              <span aria-hidden="true">↗</span></a>
<a class="text-link" href="#contact">Contact <span aria-hidden="true">↓</span></a>
